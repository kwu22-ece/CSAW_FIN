# Machine-specific configuration and backups
config.json
config.json.backup*
.env
.env.*
!.env.example

# Credentials and private keys
*token*.json
*credentials*.json
*service-account*.json
*.pem
*.key

# Local runtime state and generated output
.state/
reports/
generated/
*.db*
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Local editor and operating-system files
.claude/settings.local.json
.DS_Store
Thumbs.db

# Phase 4 local toolchain, worktrees, and generated verification artifacts
.worktrees/
.tools/
build/

# Candidate 05d (DSP): its experiments/.../reports/ is a REQUIRED committed
# deliverable. The generic reports/ rule above targets transient local tool
# output; re-include this candidate's tracked report tree (but not raw harness
# run dirs, which live under build/05d/ and stay ignored above).
!experiments/phase05/05d-opus-dsp/reports/
!experiments/phase05/05d-opus-dsp/reports/**
